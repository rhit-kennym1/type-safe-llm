# Copy to .env (gitignored) and fill in. Real environment variables override this file.
# Defaults if nothing is set: Ollama at http://localhost:11434/v1 with llama3.2:3b.

# Gemini free tier (key from Google AI Studio)
LIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LIVE_API_KEY=your-key-here
LIVE_MODEL=gemini-3.1-flash-lite
